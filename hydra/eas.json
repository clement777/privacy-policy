{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true, "resourceClass": "m-medium" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "resourceClass": "m-medium", "image": "latest" },
      "android": { "buildType": "apk" }
    },
    "preview-nowidget": {
      "extends": "preview",
      "env": { "HYDRA_NO_WIDGET": "1" },
      "ios": { "resourceClass": "m-medium" }
    },
    "development-nowidget": {
      "extends": "development",
      "env": { "HYDRA_NO_WIDGET": "1" }
    },
    "preview-android": {
      "distribution": "internal",
      "credentialsSource": "local",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "ios": { "resourceClass": "m-medium", "image": "latest" },
      "android": {}
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6790794354",
        "appleTeamId": "QN65J7X695"
      }
    }
  }
}
